# --- OpenAI ------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Default model. Callers (and the UI dropdown) may pick any id the server
# offers at GET /v1/models — currently gpt-4o and gpt-5.2.
OPENAI_MODEL=gpt-4o
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2

# Optional: correct the built-in token prices (USD per 1M tokens) without a
# code change, e.g. after a provider price update.
# MODEL_PRICING_JSON={"gpt-4o": {"input_usd_per_1m": 2.5, "output_usd_per_1m": 10.0}}

# --- Email -------------------------------------------------------------------
# The address every email is sent from. The agent never picks this itself.
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Agent Runtime

# SAFETY: while true, the email agent composes and validates messages but
# NOTHING is delivered. Set to false only when you actually want mail to go
# out — and only with the SMTP settings below filled in.
EMAIL_DRY_RUN=true

# Hard ceiling on recipients per send, so one bad instruction cannot become
# a mass mailing.
EMAIL_MAX_RECIPIENTS=5
# Optional recipient allowlist. Empty means any domain is permitted.
# EMAIL_ALLOWED_DOMAINS=example.com,team.example.com

# --- SMTP (only needed when EMAIL_DRY_RUN=false) ------------------------------
# Gmail: smtp.gmail.com:587 with an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_S=30

# --- YouTube -----------------------------------------------------------------
# A YouTube Data API v3 key: create one at
# https://console.cloud.google.com/apis/credentials and enable "YouTube Data
# API v3" for the project. Without a key the YouTube agent still appears in
# the UI, but reports that search is unavailable instead of inventing links.
YOUTUBE_API_KEY=
# Default number of videos per search, and the hard ceiling whatever the
# model asks for.
YOUTUBE_MAX_RESULTS=5
YOUTUBE_RESULT_CEILING=10
YOUTUBE_TIMEOUT_S=15
# Transcripts read the video's caption tracks and need NO API key, so they
# work even when search is unconfigured. Preferred languages, in order:
YOUTUBE_TRANSCRIPT_LANGUAGES=en
# Longest transcript handed to the model, in characters (longer ones are cut,
# and the agent is told so).
YOUTUBE_TRANSCRIPT_MAX_CHARS=20000

# --- Agent loop budget -------------------------------------------------------
# Hard ceiling on model<->tool iterations for a single run.
MAX_STEPS=8
# Per tool-call timeout and whole-run wall clock timeout, in seconds.
TOOL_TIMEOUT_S=20
RUN_TIMEOUT_S=180
# Max tool calls executed concurrently inside one step.
MAX_PARALLEL_TOOL_CALLS=4
# Stream model tokens as they are produced (SSE endpoint only).
STREAM_TOKENS=true

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
RELOAD=false
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=*

# --- Optional API auth -------------------------------------------------------
# When set, every /v1 request must send: X-API-Key: <value>
# API_KEY=

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_S=3600
SESSION_MAX_MESSAGES=40
