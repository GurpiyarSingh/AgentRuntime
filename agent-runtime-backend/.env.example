# --- OpenAI ------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Default model. Callers may pick any id the server offers at GET /v1/models
# (currently gpt-4o and gpt-5.2). Both can see images.
OPENAI_MODEL=gpt-4o
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2

# Optional: correct the built-in token prices (USD per 1M tokens) without a
# code change, e.g. after a provider price update.
# MODEL_PRICING_JSON={"gpt-4o": {"input_usd_per_1m": 2.5, "output_usd_per_1m": 10.0}}

# --- Workspace ---------------------------------------------------------------
# The only directory the agent's file tools (and the /v1/files API) can touch.
# Created on startup if missing. Paths outside it are always refused.
WORKSPACE_DIR=data/workspace
# true = the agent can list, read, search and view files, but gets no tool
# that creates or changes them.
WORKSPACE_READ_ONLY=false
# true = clients (the web app's "Browse..." button) may point the agent at
# another existing directory per request instead of WORKSPACE_DIR.
WORKSPACE_SELECTABLE=true
# Comma-separated directories clients may browse and choose beneath. Empty =
# any directory this server process can read; set it (and API_KEY) before
# exposing the server beyond localhost.
# WORKSPACE_BROWSE_ROOTS=C:\Users\me\projects,D:\data
# Largest file the agent may read, or a client may upload (bytes; 25 MB).
MAX_FILE_BYTES=26214400
# Most characters of a file handed to the model per read_file call. Longer
# files are paged, and the model is told how to continue.
READ_MAX_CHARS=40000
# Images are scaled to fit this many pixels on their longest side before
# they are sent to the model.
IMAGE_MAX_DIMENSION=2048

# --- MCP servers ----------------------------------------------------------------
# Connect Model Context Protocol servers (GitHub, Jira, Playwright, ...) and
# give their tools to the agent. Add them in the web app (Integrations →
# Manage) or the /v1/mcp API. They are stored in this file, in the same
# "mcpServers" format Claude Desktop, Cursor and VS Code use.
MCP_ENABLED=true
MCP_CONFIG_PATH=data/mcp.json
# Local (stdio) servers run a program on this machine. Set false on a shared
# server; remote (HTTP/SSE) servers still work.
MCP_ALLOW_STDIO=true

# --- Agent loop budget -------------------------------------------------------
# Hard ceiling on model<->tool iterations for a single run.
MAX_STEPS=8
# Per tool-call timeout and whole-run wall clock timeout, in seconds.
TOOL_TIMEOUT_S=60
RUN_TIMEOUT_S=180
# Max tool calls executed concurrently inside one step.
MAX_PARALLEL_TOOL_CALLS=4
# Stream model tokens as they are produced (SSE endpoint only).
STREAM_TOKENS=true

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
RELOAD=false
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=*

# --- Optional API auth -------------------------------------------------------
# When set, every /v1/chat* and /v1/files* request must send: X-API-Key: <value>
# Set this before exposing the server beyond localhost: the files API can
# read, upload and delete anything in the workspace.
# API_KEY=

# --- Persistence -------------------------------------------------------------
# When set, every session, its transcript, and each run's events, tool calls,
# tokens and cost are stored here and survive restarts (tables are created on
# startup). The database itself must exist: CREATE DATABASE agent_runtime;
# Unset = sessions live in memory only and nothing is recorded.
# From Docker, reach a database on this machine via host.docker.internal.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/agent_runtime
# Log every SQL statement (debugging only).
DATABASE_ECHO=false

# --- Sign-in (needs DATABASE_URL) ---------------------------------------------
# With a database, the web app asks people to sign in and each person sees only
# their own conversations. The first visitor creates the admin account; add
# more people with:  agent-runtime users add NAME  (or list them: users list).
# API_KEY, if set, still works for scripts and sees every session.
AUTH_ENABLED=true
# How long a sign-in lasts before the browser must sign in again (hours).
AUTH_TOKEN_TTL_HOURS=168

# --- Sessions ----------------------------------------------------------------
# Idle time before an in-memory session is forgotten (ignored with a database).
SESSION_TTL_S=3600
# Most messages replayed to the model per turn. With a database every message
# is still stored; only what the model sees is trimmed.
SESSION_MAX_MESSAGES=40
