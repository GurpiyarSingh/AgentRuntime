# Copy to .env.local to override. Every VITE_* value is compiled into the
# JavaScript bundle and visible to anyone who loads the page: never put a
# secret here. The API key is entered in the UI instead.

# Where the backend lives. Leave empty when the UI is served from the same
# origin as the API (the dev proxy, or a reverse proxy in production).
# Set it to a full URL (e.g. https://agent.example.com) to call a backend on
# another origin; that backend must then list this UI's origin in
# CORS_ALLOW_ORIGINS.
VITE_API_BASE_URL=

# Development only: the backend the Vite dev server proxies /v1 and /health to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
